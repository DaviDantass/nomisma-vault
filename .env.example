# Copy this file to .env and fill in the values
# NEVER commit the .env file (it is already in .gitignore)

# PostgreSQL
POSTGRES_DB=nomismavault
POSTGRES_USER=nomismavault_user
POSTGRES_PASSWORD=nomismavault_pass

# JWT (use a strong secret in production — minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
JWT_EXPIRATION=86400000

# Brapi API token (get yours at https://brapi.dev)
BRAPI_API_TOKEN=your-brapi-token-here
